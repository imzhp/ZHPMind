# macOS
.DS_Store

# Obsidian — 窗口布局,每次操作都变,纯噪声
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# 插件运行时数据(可能含 API key,且频繁变动)
.obsidian/plugins/*/data.json

# 插件代码(可通过 community-plugins.json + BRAT 重装)
.obsidian/plugins/*/main.js
.obsidian/plugins/*/styles.css

# Smart Environment 索引(从 vault 内容完全可重建)
.smart-env/

# Claudian 会话日志(临时性)
.claudian/

# Codex vault 级技能:只跟踪 skills,忽略其他本地运行态
.codex/*
!.codex/
!.codex/skills/
!.codex/skills/**

# Claude Code — 仅 ignore 临时会话和备份文件
# skills/agents/commands 默认 track,对应 design-principles 第二层 Skill 系统设计
.claude/sessions/
.claude/**/*.bak

# iCloud Optimize Storage 占位符
*.icloud

# claude-drafts: 跨机交接草稿,跟踪 README + handoff/result 文件
claude-drafts/*
!claude-drafts/README.md
!claude-drafts/handoff-*.md
!claude-drafts/result-*.md

# 电子书源:二进制不进 git
*.epub

# 书籍/课程 PDF·DOCX 源:二进制不进 git(留盘 + Obsidian Sync)。2026-06-01 filter-repo 瘦身后立规。
*.pdf
*.docx

# Device-local WeRead source snapshots and conflict state
/.weread-sync-v1/

/.zhpmind-weread-sync-v1/

/.zhpmind-weread-cache/
