# macOS
.DS_Store

# Obsidian — 窗口布局,每次操作都变,纯噪声
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# 插件运行时数据(可能含 API key,且频繁变动)
.obsidian/plugins/*/data.json

# 插件代码(可通过 community-plugins.json + BRAT 重装)
.obsidian/plugins/*/main.js
.obsidian/plugins/*/styles.css

# Smart Environment 索引(从 vault 内容完全可重建)
.smart-env/

# Claudian 会话日志(临时性)
.claudian/

# Claude Code — 仅 ignore 临时会话和备份文件
# skills/agents/commands 默认 track,对应 design-principles 第二层 Skill 系统设计
.claude/sessions/
.claude/**/*.bak

# Claude Code ↔ 主对话 传输通道
# 默认入 git,只排除真临时文件
# 教训:2026-05-26 因整目录 gitignored 导致 amazon 对照表 v0.9 在 iCloud→Sync 迁移中物理丢失
# 现策略:drafts/诊断报告进 git 历史 + 每版必 commit;只排除 .bak / .tmp / scratch / incoming 子目录
.tmp-claude-reports/*.bak
.tmp-claude-reports/*.tmp
.tmp-claude-reports/*~
.tmp-claude-reports/incoming-*/
.tmp-claude-reports/scratch-*
.tmp-claude-reports/.DS_Store

# iCloud Optimize Storage 占位符
*.icloud

# claude-drafts: 跨机交接草稿,仅跟踪 README
claude-drafts/*
!claude-drafts/README.md

# 电子书源:二进制不进 git
*.epub
