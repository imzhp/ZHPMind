#!/bin/bash
set -uo pipefail

PATH="/Users/zhanghaopeng/.local/bin:/Users/zhanghaopeng/.venv/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

VAULT="/Users/zhanghaopeng/Obsidian/ZHPMind"
INBOX="$VAULT/inbox"
LOG="/Users/zhanghaopeng/Library/Logs/ZHPMind/zhpmind-autocommit.log"
STATUS_DIR="/Users/zhanghaopeng/Library/Application Support/ZHPMind"
OBSIDIAN_STATE="$STATUS_DIR/zhpmind-autocommit-obsidian-last-date"

mkdir -p "$STATUS_DIR"

trim_log() {
  if [ -f "$LOG" ]; then
    tail -n 500 "$LOG" > "$LOG.tmp" 2>/dev/null && mv "$LOG.tmp" "$LOG"
  fi
}

log_line() {
  printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG"
  trim_log
}

write_alert() {
  local today alert reason detail
  today="$(date '+%Y-%m-%d')"
  alert="$INBOX/alert-git-autocommit-$today.md"
  reason="${1:-unknown}"
  detail="${2:-}"

  if [ -f "$alert" ]; then
    log_line "alert already exists: $alert reason=$reason"
    return 0
  fi

  mkdir -p "$INBOX"
  {
    printf '%s\n' '---'
    printf '%s\n' 'type: snapshot'
    printf '%s\n' 'source: zhpmind-autocommit'
    printf 'created: %s\n' "$today"
    printf '%s\n' 'tags: [system-alert]'
    printf '%s\n' '---'
    printf '\n# ZHPMind git autocommit alert — %s\n\n' "$today"
    printf 'ZHPMind auto-commit watcher needs attention.\n\n'
    printf '%s\n' "- Reason: $reason"
    if [ -n "$detail" ]; then
      printf '%s\n' "- Detail: $detail"
    fi
  } > "$alert"

  log_line "alert written: $alert reason=$reason"
}

git_marker_active() {
  local marker
  for marker in \
    "$VAULT/.git/index.lock" \
    "$VAULT/.git/rebase-merge" \
    "$VAULT/.git/rebase-apply" \
    "$VAULT/.git/MERGE_HEAD"
  do
    if [ -e "$marker" ]; then
      log_line "skip: git operation marker exists: $marker"
      return 0
    fi
  done
  return 1
}

has_changes() {
  [ -n "$(git -C "$VAULT" status --porcelain --untracked-files=all)" ]
}

recent_file_changed() {
  find "$VAULT" \( -path "$VAULT/.git" -o -path "$VAULT/.obsidian" \) -prune -o -type f -mmin -2 -print -quit 2>/dev/null | grep -q .
}

only_obsidian_changes() {
  local entry path
  while IFS= read -r -d '' entry; do
    path="${entry:3}"
    case "$path" in
      .obsidian/*)
        ;;
      *)
        return 1
        ;;
    esac
  done < <(git -C "$VAULT" status --porcelain -z --untracked-files=all)
  return 0
}

pure_obsidian_already_committed_today() {
  local today last
  today="$(date '+%Y-%m-%d')"
  last="$(cat "$OBSIDIAN_STATE" 2>/dev/null || true)"
  [ "$last" = "$today" ]
}

pull_rebase_autostash() {
  if git -C "$VAULT" pull --rebase --autostash origin main >> "$LOG" 2>&1; then
    log_line "pull --rebase --autostash ok"
    return 0
  fi

  log_line "pull --rebase --autostash failed"
  if [ -d "$VAULT/.git/rebase-merge" ] || [ -d "$VAULT/.git/rebase-apply" ]; then
    git -C "$VAULT" rebase --abort >> "$LOG" 2>&1 || true
    log_line "rebase aborted after pull failure"
  fi
  write_alert "pull-rebase-conflict" "git pull --rebase --autostash origin main failed"
  return 1
}

commit_changes() {
  local files file_count message body today was_pure_obsidian

  if ! has_changes; then
    log_line "no changes to commit"
    return 0
  fi

  was_pure_obsidian=1
  if only_obsidian_changes; then
    was_pure_obsidian=0
  fi

  if [ "$was_pure_obsidian" -eq 0 ] && pure_obsidian_already_committed_today; then
    log_line "skip: pure .obsidian changes already committed today"
    return 0
  fi

  files="$(git -C "$VAULT" status --porcelain --untracked-files=all)"
  file_count="$(printf '%s\n' "$files" | sed '/^$/d' | wc -l | tr -d ' ')"
  message="auto: $(date '+%Y-%m-%d %H:%M') ${file_count} files"
  body="$(printf 'Files:\n%s\n' "$files")"

  git -C "$VAULT" add -A >> "$LOG" 2>&1
  if git -C "$VAULT" diff --cached --quiet; then
    log_line "no staged changes after git add"
    return 0
  fi

  if git -C "$VAULT" commit -m "$message" -m "$body" >> "$LOG" 2>&1; then
    log_line "commit ok: $message"
    if [ "$was_pure_obsidian" -eq 0 ]; then
      today="$(date '+%Y-%m-%d')"
      printf '%s\n' "$today" > "$OBSIDIAN_STATE"
    fi
    return 0
  fi

  log_line "commit failed: $message"
  write_alert "commit-failed" "$message"
  return 1
}

push_with_retry() {
  if git -C "$VAULT" push origin main >> "$LOG" 2>&1; then
    log_line "push ok"
    return 0
  fi

  log_line "push failed; retrying after pull --rebase --autostash"
  if pull_rebase_autostash && git -C "$VAULT" push origin main >> "$LOG" 2>&1; then
    log_line "push retry ok"
    return 0
  fi

  log_line "push retry failed"
  write_alert "push-failed" "git push failed after one pull --rebase retry"
  return 1
}

main() {
  if [ ! -d "$VAULT/.git" ]; then
    log_line "vault git repo not found: $VAULT"
    return 1
  fi

  if git_marker_active; then
    return 0
  fi

  if has_changes && recent_file_changed; then
    log_line "skip: working tree has changes and files modified within last 2 minutes"
    return 0
  fi

  pull_rebase_autostash || return 0
  commit_changes || return 0
  push_with_retry || return 0
}

main "$@"
